# GitGrade Environment Variables
# Copy this file to .env and fill in your values

# ==========================================
# HYBRID AI ENGINE (Dual-Brain Architecture)
# ==========================================

# GROQ API Key (RECOMMENDED for Fast Mode ~1 second responses)
# Uses Llama-3-70b - Free tier: 30 RPM, 14,400 RPD
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-api-key-here

# Google Gemini API Key (REQUIRED for Deep Mode)
# Uses Gemini 1.5 Pro - 2M token context window
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ==========================================
# GITHUB ACCESS
# ==========================================

# GitHub Personal Access Token (optional, but recommended for higher rate limits)
# Without token: 60 requests/hour | With token: 5000 requests/hour
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your-github-token-here
